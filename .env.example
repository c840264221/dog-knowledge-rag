# Copy this file to .env for local development or to .env.docker for Docker.
# Never commit real API keys or tokens.

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
# API_ENVIRONMENT：API 运行环境，可选 development、test 或 production。
API_ENVIRONMENT=development
# API_HOST：Uvicorn 监听地址；Docker 中通常设置为 0.0.0.0。
API_HOST=127.0.0.1
# API_PORT：Uvicorn 监听端口，必须在 1 到 65535 之间。
API_PORT=8000
# API_WORKERS：Uvicorn 工作进程数；当前进程内任务注册架构只允许设置为 1。
API_WORKERS=1
# API_RELOAD：代码变化时是否自动重启服务，只适合本地开发环境。
API_RELOAD=false
# API_LOG_LEVEL：Uvicorn 日志等级，例如 info、warning 或 error。
API_LOG_LEVEL=info
# API_ACCESS_LOG：是否输出每次 HTTP 请求的 Uvicorn 访问日志。
API_ACCESS_LOG=true

# ---------------------------------------------------------------------------
# Application and logging
# ---------------------------------------------------------------------------
# APP_NAME：应用名称，会用于 FastAPI 标题等对外展示位置。
APP_NAME=Dog Knowledge RAG
# DEBUG：是否开启应用调试模式，生产环境应设置为 false。
DEBUG=true
# LOG_LEVEL：项目控制台日志的最低输出等级。
LOG_LEVEL=INFO
# LOG_BACKTRACE：发生异常时是否输出更完整的 Loguru 调用栈。
LOG_BACKTRACE=false
# LOG_DIAGNOSE：是否输出变量诊断信息，生产环境建议关闭以避免泄露敏感数据。
LOG_DIAGNOSE=false

# ---------------------------------------------------------------------------
# Main LLM
# ---------------------------------------------------------------------------
# MAIN_MODEL：主 LLM 模型名称，正常请求优先调用该模型。
MAIN_MODEL=deepseek-v4-pro
# BACKUP_MODEL：主模型调用失败时使用的备用 LLM 模型名称。
BACKUP_MODEL=deepseek-v4-flash
# CHINESE_MODEL：处理中文或本地模型任务时使用的 Ollama 模型名称。
CHINESE_MODEL=qwen2.5:7b
# DEEPSEEK_API_KEY：DeepSeek 兼容服务的访问密钥，真实值只能写入私有配置。
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL：DeepSeek 兼容 API 的基础地址。
DEEPSEEK_BASE_URL=
# TEMPERATURE：LLM 生成随机度，数值越低结果通常越稳定。
TEMPERATURE=0
# MAX_ATTEMPTS：LLM 安全调用允许的最大尝试次数。
MAX_ATTEMPTS=3
# REQUEST_TIMEOUT：单次 LLM 网络请求的最长等待秒数。
REQUEST_TIMEOUT=60
# MAX_TOKENS：单次 LLM 回答允许生成的最大 Token 数量。
MAX_TOKENS=2048

# Local Ollama service used by the Chinese LLM and memory embedding.
# In Docker, localhost points to the API container itself. Replace these
# values with the real Ollama service address when Ollama runs elsewhere.
# OLLAMA_BASE_URL：项目 LLMProvider 连接 Ollama 服务时使用的基础地址。
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_HOST：Ollama 客户端库读取的服务地址，容器中不能直接沿用宿主机 localhost。
OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Embedding and reranker
# ---------------------------------------------------------------------------
# EMBEDDING_PROVIDER：RAG 文档向量模型提供方，可选 huggingface 或 ollama。
EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL_NAME：RAG 文档和问题向量化使用的模型名称。
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh
# EMBEDDING_DEVICE：RAG Embedding 模型运行设备，例如 cpu 或 cuda。
EMBEDDING_DEVICE=cpu
# EMBEDDING_NORMALIZE_EMBEDDINGS：是否对 RAG 向量进行归一化。
EMBEDDING_NORMALIZE_EMBEDDINGS=true
# EMBEDDING_MEMORY_PROVIDER：Memory 语义向量模型提供方。
EMBEDDING_MEMORY_PROVIDER=ollama
# EMBEDDING_MEMORY_MODEL_NAME：Memory 保存和召回时使用的向量模型名称。
EMBEDDING_MEMORY_MODEL_NAME=qwen3-embedding:0.6b
# EMBEDDING_MEMORY_DEVICE：Memory Embedding 模型运行设备。
EMBEDDING_MEMORY_DEVICE=cpu
# EMBEDDING_MEMORY_NORMALIZE_EMBEDDINGS：是否对 Memory 向量进行归一化。
EMBEDDING_MEMORY_NORMALIZE_EMBEDDINGS=true
# HUGGINGFACE_TOKEN：下载受权限保护的 HuggingFace 模型时使用的访问令牌。
HUGGINGFACE_TOKEN=

# ---------------------------------------------------------------------------
# Runtime, middleware, timeout and retry
# ---------------------------------------------------------------------------
# TOOL_TIMEOUT：单次工具执行允许的最长秒数。
TOOL_TIMEOUT=30
# RETRY_DELAY：工具或运行时重试之间等待的秒数。
RETRY_DELAY=1
# MAX_RETRIES：普通运行时异常允许的最大重试次数。
MAX_RETRIES=3
# TOOL_CONCURRENCY：同一进程允许并发执行的工具数量上限。
TOOL_CONCURRENCY=10
# ENABLE_TRACE：是否开启请求链路追踪。
ENABLE_TRACE=true
# ENABLE_EVENT_BUS：是否开启运行时事件总线。
ENABLE_EVENT_BUS=true
# ENABLE_STRUCTURED_LOGGING：是否开启结构化日志能力。
ENABLE_STRUCTURED_LOGGING=true
# ENABLE_RETRY：是否开启全局重试能力。
ENABLE_RETRY=true
# ENABLE_TIMEOUT：是否开启全局超时控制。
ENABLE_TIMEOUT=true
# STREAM_CHUNK_TIMEOUT：流式响应等待下一块数据的最长秒数。
STREAM_CHUNK_TIMEOUT=120
# ENABLE_RETRY_MIDDLEWARE：工具执行链是否启用重试中间件。
ENABLE_RETRY_MIDDLEWARE=true
# ENABLE_TIMEOUT_MIDDLEWARE：工具执行链是否启用超时中间件。
ENABLE_TIMEOUT_MIDDLEWARE=true
# ENABLE_TRACE_MIDDLEWARE：工具执行链是否启用追踪中间件。
ENABLE_TRACE_MIDDLEWARE=true
# ENABLE_LOGGING_MIDDLEWARE：工具执行链是否启用日志中间件。
ENABLE_LOGGING_MIDDLEWARE=true
# ENABLE_ASYNC_MIDDLEWARE：工具执行链是否启用异步执行中间件。
ENABLE_ASYNC_MIDDLEWARE=true
# MULTI_AGENT_MAXIMUM_PARALLEL_STEPS：同一批次最多并发执行的多智能体步骤数。
MULTI_AGENT_MAXIMUM_PARALLEL_STEPS=4
# MULTI_AGENT_STEP_TIMEOUT_SECONDS：单个多智能体 Worker 步骤的超时秒数。
MULTI_AGENT_STEP_TIMEOUT_SECONDS=120
# MULTI_AGENT_MAXIMUM_STEP_ATTEMPTS：单个 Worker 的总尝试次数，包含第一次执行。
MULTI_AGENT_MAXIMUM_STEP_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
# MEMORY_SEMANTIC_WEIGHT：Memory 排序时语义相关度所占权重。
MEMORY_SEMANTIC_WEIGHT=3.0
# MEMORY_MEMORY_WEIGHT：Memory 强度和时间衰减分数所占权重。
MEMORY_MEMORY_WEIGHT=1.0
# MEMORY_CONFIDENCE_WEIGHT：Memory 可信度分数所占权重。
MEMORY_CONFIDENCE_WEIGHT=0.5
# MEMORY_IMPORTANCE_WEIGHT：Memory 重要程度分数所占权重。
MEMORY_IMPORTANCE_WEIGHT=0.5
# MEMORY_MINIMUM_SEMANTIC_SCORE：记忆进入精排阶段所需的最低语义分数。
MEMORY_MINIMUM_SEMANTIC_SCORE=0.45
# MEMORY_DEFAULT_TOP_K：Memory 语义召回默认返回的最终结果数量。
MEMORY_DEFAULT_TOP_K=5
# MEMORY_DEFAULT_CANDIDATE_K：Memory 精排前默认召回的候选数量。
MEMORY_DEFAULT_CANDIDATE_K=20

# ---------------------------------------------------------------------------
# RAG retrieval quality and retry
# ---------------------------------------------------------------------------
# RAG_QUALITY_MIN_SCORE：RAG 召回结果被判定合格所需的最低综合质量分。
RAG_QUALITY_MIN_SCORE=0.7
# RAG_QUALITY_MIN_CONTEXT_CHARS：RAG 上下文被判定有效所需的最少字符数。
RAG_QUALITY_MIN_CONTEXT_CHARS=100
# RAG_QUALITY_MAX_DISTANCE：向量召回结果允许的最大距离，越小通常越相似。
RAG_QUALITY_MAX_DISTANCE=0.8
# RAG_QUALITY_ENABLE_METADATA_CHECK：质量评估时是否检查 Metadata 命中情况。
RAG_QUALITY_ENABLE_METADATA_CHECK=true
# RAG_QUALITY_ENABLE_SECTION_CHECK：质量评估时是否检查文档章节与问题主题匹配。
RAG_QUALITY_ENABLE_SECTION_CHECK=true
# RAG_QUALITY_ENABLE_SCORE_CHECK：质量评估时是否检查向量召回分数。
RAG_QUALITY_ENABLE_SCORE_CHECK=true
# RAG_QUALITY_NON_EMPTY_WEIGHT：召回结果非空在综合质量分中的权重。
RAG_QUALITY_NON_EMPTY_WEIGHT=0.2
# RAG_QUALITY_METADATA_HIT_WEIGHT：Metadata 命中在综合质量分中的权重。
RAG_QUALITY_METADATA_HIT_WEIGHT=0.3
# RAG_QUALITY_SECTION_HIT_WEIGHT：章节主题命中在综合质量分中的权重。
RAG_QUALITY_SECTION_HIT_WEIGHT=0.2
# RAG_QUALITY_SCORE_WEIGHT：向量召回分数合格在综合质量分中的权重。
RAG_QUALITY_SCORE_WEIGHT=0.2
# RAG_QUALITY_CONTEXT_LENGTH_WEIGHT：上下文长度合格在综合质量分中的权重。
RAG_QUALITY_CONTEXT_LENGTH_WEIGHT=0.1
# RAG_RETRY_MAX_COUNT：RAG 召回质量不合格时允许的最大重试次数。
RAG_RETRY_MAX_COUNT=3
# RAG_RETRY_FIRST_TOP_K：RAG 第一次放宽召回时使用的候选数量。
RAG_RETRY_FIRST_TOP_K=10
# RAG_RETRY_SECOND_TOP_K：RAG 第二次放宽召回时使用的候选数量。
RAG_RETRY_SECOND_TOP_K=15
# RAG_RETRY_THIRD_TOP_K：RAG 第三次放宽召回时使用的候选数量。
RAG_RETRY_THIRD_TOP_K=25
# RAG_RETRY_CORE_FILTER_FIELDS：RAG 重试时始终保留的核心过滤字段 JSON 列表。
RAG_RETRY_CORE_FILTER_FIELDS=["dog_name","size"]

# ---------------------------------------------------------------------------
# Observability and debug reports
# ---------------------------------------------------------------------------
# ENABLE_CONSOLE_TIMELINE_REPORT：是否在控制台打印请求时间线报告。
ENABLE_CONSOLE_TIMELINE_REPORT=false
# ENABLE_CONSOLE_RUNTIME_REPORT：是否在控制台打印完整运行时报告。
ENABLE_CONSOLE_RUNTIME_REPORT=false
# ENABLE_RAG_DEBUG_REPORT：是否生成 RAG 调试报告。
ENABLE_RAG_DEBUG_REPORT=true
# RAG_DEBUG_REPORT_TO_CONSOLE：是否把 RAG 调试报告打印到控制台。
RAG_DEBUG_REPORT_TO_CONSOLE=false
# RAG_DEBUG_REPORT_TO_FILE：是否把 RAG 调试报告保存到文件。
RAG_DEBUG_REPORT_TO_FILE=true
# RAG_DEBUG_CONTEXT_MAX_CHARS：调试报告中最多保留的 RAG 上下文字符数。
RAG_DEBUG_CONTEXT_MAX_CHARS=1200
# RAG_DEBUG_ANSWER_MAX_CHARS：调试报告中最多保留的最终回答字符数。
RAG_DEBUG_ANSWER_MAX_CHARS=1200
# RAG_DEBUG_REPORT_USE_DATE_DIR：调试报告是否按日期创建子目录。
RAG_DEBUG_REPORT_USE_DATE_DIR=true
# RAG_DEBUG_REPORT_RETENTION_DAYS：RAG 调试报告保留天数。
RAG_DEBUG_REPORT_RETENTION_DAYS=7
# RAG_DEBUG_REPORT_CLEANUP_ON_WRITE：写入新报告时是否顺便清理过期报告。
RAG_DEBUG_REPORT_CLEANUP_ON_WRITE=true

# Optional LangSmith tracing. Leave the key empty when it is disabled.
# LANGSMITH_TRACING：是否启用 LangSmith 链路追踪。
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY：LangSmith 服务访问密钥，禁用时保持为空。
LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT：LangSmith 服务 API 地址。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT：LangSmith 中用于归类追踪记录的项目名称。
LANGSMITH_PROJECT=dog-agent-framework

# ---------------------------------------------------------------------------
# Persistent paths
# Relative paths are resolved against the project base directory.
# Docker will mount the corresponding directories as persistent volumes.
# ---------------------------------------------------------------------------
# DATA_DIR：项目运行数据的根目录。
DATA_DIR=data
# LOG_DIR：应用日志文件保存目录。
LOG_DIR=logs
# REPORT_DIR：运行报告和调试报告的根目录。
REPORT_DIR=logs/report
# RAG_DEBUG_REPORT_DIR：RAG 调试报告保存目录。
RAG_DEBUG_REPORT_DIR=logs/report/rag_debug
# RAG_EVALUATE_REPORT_DIR：RAG 评估报告保存目录。
RAG_EVALUATE_REPORT_DIR=logs/report/rag_evaluate
# CACHE_DIR：HuggingFace 等模型文件的本地缓存目录。
CACHE_DIR=models_cache
# CHROMA_DB_DIR：狗狗知识 RAG Chroma 向量库持久化目录。
CHROMA_DB_DIR=chroma_db
# MEMORY_CHROMA_DB_DIR：Memory Chroma 向量库持久化目录。
MEMORY_CHROMA_DB_DIR=chroma_memory_db
# CHECKPOINT_DIR：LangGraph 检查点数据库所在目录。
CHECKPOINT_DIR=data/checkpoints_db
# MEMORY_DIR：SQLite Memory 主数据库所在目录。
MEMORY_DIR=data/memory_db
# USER_DIR：用户本地结构化数据保存目录。
USER_DIR=data/user
# DOG_MD_DATA_DIR：RAG 入库使用的狗狗 Markdown 原始资料目录。
DOG_MD_DATA_DIR=data/dog_markdown
# DOG_NAME_JSON_PATH：狗狗名称标准化数据文件路径。
DOG_NAME_JSON_PATH=data/dog_names.json
# DOG_NAME_ALIAS_JSON_PATH：狗狗名称别名映射文件路径。
DOG_NAME_ALIAS_JSON_PATH=data/alias_dog_name.json
# DOG_DATA_JSON_PATH：狗狗结构化原始数据文件路径。
DOG_DATA_JSON_PATH=data/dogs.json
# FILTER_RULES_PATH：RAG Metadata 过滤规则文件路径。
FILTER_RULES_PATH=data/filter_rules.json
# INTENT_RULES_PATH：用户意图识别规则文件路径。
INTENT_RULES_PATH=data/intent_rules.json
# TAG_RULES_PATH：狗狗知识标签规则文件路径。
TAG_RULES_PATH=data/tag_rules.json
# CHECKPOINTS_DB_PATH：LangGraph AsyncSqliteSaver 使用的 SQLite 文件路径。
CHECKPOINTS_DB_PATH=data/checkpoints_db/checkpoints.db
# MEMORY_DB_PATH：长期记忆 SQLite 数据库文件路径。
MEMORY_DB_PATH=data/memory_db/memory.db
# USER_FILE：本地用户数据 JSON 文件路径。
USER_FILE=data/user/user.json

# ---------------------------------------------------------------------------
# SQLite MCP
# Keep the whitelist empty unless the database files are mounted read-only.
# ---------------------------------------------------------------------------
# MCP_SQLITE_ENABLED：是否启用 SQLite MCP 只读数据库工具。
MCP_SQLITE_ENABLED=true
# MCP_SQLITE_ALLOWED_DATABASES：允许查询的数据库别名到文件路径的 JSON 映射。
MCP_SQLITE_ALLOWED_DATABASES={}
# MCP_SQLITE_DEFAULT_LIMIT：SQLite MCP 查询未指定数量时的默认返回行数。
MCP_SQLITE_DEFAULT_LIMIT=20
# MCP_SQLITE_MAX_LIMIT：SQLite MCP 单次查询允许返回的最大行数。
MCP_SQLITE_MAX_LIMIT=100
